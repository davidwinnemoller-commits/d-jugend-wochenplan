# Kalender-Link von fussball.de (Rechtsklick auf "Kalender abonnieren" -> Link kopieren)
FUSSBALL_ICAL_URL="https://www.fussball.de/export.ics/-/id/DEINE_TEAM_ID"

# Deine Handynummer im internationalen Format (ohne führende Nullen, mit Ländervorwahl, z.B. +491701234567)
CALLMEBOT_PHONE="+491701234567"

# Dein CallMeBot API-Key (bekommst du kostenlos in 30 Sekunden per WhatsApp)
CALLMEBOT_APIKEY="123456"

# Name deiner Mannschaft (z.B. TSV Musterdorf) zur Unterscheidung von Heim- und Auswärtsspielen
MY_TEAM_NAME="TSV Musterdorf"

# Deine Trainingszeiten
TRAINING_MONTAG_TIME="17:30 – 19:00 Uhr"
TRAINING_MITTWOCH_TIME="17:30 – 19:00 Uhr"

# Treffpunkt vor dem Spiel in Minuten (z.B. 45)
TREFFPUNKT_OFFSET_MINUTES="45"
